  },
  "7": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["6", 0],
      "frame_rate": 8,
      "loop_count": 0,
      "filename_prefix": "db_cogvideox",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "save_output": true
